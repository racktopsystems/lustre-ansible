---
# Copy to group_vars/lustre_nodes and adjust for the site.

# Name of the Lustre file system exposed to the clients: 1-8 letters, digits,
# '_' or '-'.
filesystem_name: bsrfs

# The HA group (oss or mds) whose lustre_targets include the MGS, as role mgt
# or mgsmdt. Its nodes' NIDs become --mgsnid for every MDT and OST.
# Defaults to mds (group_vars/all).
# lustre_mgs_group: mds

# Lustre targets themselves are listed per HA group as `lustre_targets` in
# the inventory; see inventory.yaml.example and tasks/lustre-storage.yml.
# NIDs are read from each server's LNET configuration (lnet_networks in
# group_vars/all), so none are listed here.
