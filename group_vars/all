# Variables Ansible is aware of.
any_errors_fatal: "{{ fastfail | default(false) }}"

# All other common variables.
# NetworkManager connection carrying the heartbeat link on `hb_iface`.
hb_conn_name: "hb0"
# Interface addresses (`hb_iface_ipaddr`, `ib_addrs`) are CIDR, e.g. 10.0.0.5/24.
# This is the bare heartbeat address for configs that take no prefix.
hb_iface_address: "{{ hb_iface_ipaddr.split('/') | first }}"

lustreadm_bin: /usr/racktop/sbin/lustreadm

# LNET (tasks/lnet-setup.yml). `lnet_networks` lists a Lustre server's LNET
# networks in order; the first interface of the first network gives the
# server its primary NID. A network over several interfaces is Multi-Rail
# across them, and a server on several networks is Multi-Rail across those
# as well. The default is one network, `lnet_nettype` instance
# `lnet_netnum`, over every interface with an address in `ib_addrs`.
# Set it per host or per group, e.g. one network per InfiniBand fabric plus
# Ethernet:
#
#   lnet_networks:
#     - {nettype: o2ib, netnum: 0, ifaces: [ib0]}
#     - {nettype: o2ib, netnum: 1, ifaces: [ib1]}
#     - {nettype: tcp, netnum: 0, ifaces: [ens1f0]}
#
# Interfaces other than those in `ib_addrs` must already have an IPv4
# address; LNET derives each NID from it.
#
# The other LNET settings, also per host or per group:
#
#   lnet_manage_peers: true   Configure every other Lustre server as a
#       Multi-Rail peer with all of its NIDs, so LNET uses all of them from
#       the start rather than once discovery finds them. Peers are
#       reconciled per network: a configured peer that is neither a Lustre
#       server nor in lnet_extra_peers is removed. Peers found by discovery
#       are left alone.
#   lnet_extra_peers: []      Peers that are not Lustre servers in this
#       inventory (clients, routers), each as its primary NID followed by
#       its other NIDs, e.g. "10.0.0.50@o2ib,10.1.0.50@o2ib1".
#   lnet_discovery:           true or false turns LNET dynamic peer
#       discovery on or off; unset keeps the current setting (LNET's
#       default is on).
#   lnet_prune_networks: false  Remove LNET networks that are configured
#       but not in lnet_networks.
#
# None of these is defined here, because a variable in group_vars/all takes
# precedence over group variables in the inventory file; the tasks supply
# the defaults instead. lnet_networks defaults to lnet_networks_default.
lnet_nettype: o2ib
lnet_netnum: 0
lnet_networks_default:
  - nettype: "{{ lnet_nettype }}"
    netnum: "{{ lnet_netnum }}"
    ifaces: "{{ ib_addrs | default({}) | dict2items | selectattr('value') | map(attribute='key') | list }}"

# The Lustre servers: both HA pairs, not the witness.
lustre_servers: "{{ (groups['oss'] | default([])) + (groups['mds'] | default([])) }}"

# Lustre targets (tasks/lustre-storage.yml) are created and mounted by
# lustred through lustreadm. Each HA group (oss, mds) lists its targets in
# `lustre_targets` in the inventory. `lustre_mgs_group` names the HA group
# whose targets include the MGS (role mgt or mgsmdt); its nodes' NIDs are
# passed to every MDT and OST as --mgsnid. A node's NIDs are all of its LNET
# NIDs, as lustred reports them, primary first.
lustre_mgs_group: mds

# NTP servers chrony synchronizes with (tasks/ntp-setup.yml). Set the
# site's servers as `ntp_servers` (hostnames or IP addresses) in the
# inventory, e.g. under `all: vars:`, or in group_vars/lustre_nodes; it is
# not defined here, because group_vars/all would take precedence over the
# inventory file. Without it these public pools are used, which only works
# with internet access. `ntp_server_options` (default "iburst") is added to
# each server line.
ntp_servers_default:
  - "0.us.pool.ntp.org"
  - "1.us.pool.ntp.org"
  - "2.us.pool.ntp.org"
  - "3.us.pool.ntp.org"

# IPMI settings should be consistent across systems. The username normally
# root, but could be sometihng else.
ipmi_username: "testuser" # Name of the IPMI user to create
ipmi_user_id: 4
ipmi_password_hash_file: /var/tmp/ipmi-hash
ipmi_password_hash_file_mode: "0400"
ipmi_setup_script_path: /run/ipmi_user_setup.sh
update_necessary: true
hide_sensitive_output: false

# Licensing (tasks/registration.yml). Each HA node's .oreg file is named by
# its `license_file` inventory variable.
licadm_bin: /usr/racktop/sbin/licadm
license_remote_file: /root/license.oreg
# Name recorded as accepting the EULA. Personalize if the customer prefers.
license_eula_signer: "System Administrator"
bsr_config_file: /etc/bsr.conf

# This tunable enables us to unconditionally regenerate HA configuration
# files on the cluster nodes and the witness. Normally we don't regenerate
# them after their initial creation.
hiavd_force_config_recreation: false
hiavd_initial_revision_id: 1

# Multi-cluster witness support.
#
# A single witness host can serve several HA clusters by running one confd and
# one hiavd instance per cluster. The ha-witness RPM supports this natively:
# instance 0 is the default confd.service/hiavd.service, and instance N > 0 is
# confd@N.service/hiavd@N.service. The services derive their file locations
# and confd ports from the instance number:
#
#   instance  hiavd config                           hiavd port  confd ports
#   0         /etc/racktop/hiavd/hiavd.conf          4746        2379, 2380
#   1         /etc/racktop/hiavd_1/hiavd_1.conf      4747        2381, 2382
#   N         /etc/racktop/hiavd_N/hiavd_N.conf      4746+N      2379+2N, 2380+2N
#
# hiavd does not derive its port from the instance; CommsPort in the
# configuration file sets it. Every member of a cluster must use the same
# CommsPort, so the HA pair and its witness instance share ha_comms_port.
#
# witness_instance is set in the inventory on each HA group and on each
# cluster_witness entry. The HA nodes always run the default service
# instances; only the witness uses instance-specific names and paths.
witness_instance_id: "{{ witness_instance | default(0) | int }}"
ha_instance_suffix: "{{ '_' ~ witness_instance_id if ('cluster_witness' in group_names and witness_instance_id | int > 0) else '' }}"
ha_comms_port: "{{ 4746 + (witness_instance_id | int) }}"
confd_client_port: "{{ 2379 + 2 * (witness_instance_id | int) }}"
confd_peer_port: "{{ 2380 + 2 * (witness_instance_id | int) }}"
hiavd_service: "{{ 'hiavd@' ~ witness_instance_id if ha_instance_suffix else 'hiavd' }}"
confd_service: "{{ 'confd@' ~ witness_instance_id if ha_instance_suffix else 'confd' }}"

# hiavd keeps identifiers.dat and serialized.dat beside its configuration file.
hiavd_instance_name: "hiavd{{ ha_instance_suffix }}"
hiavd_conf_dir: "/etc/racktop/{{ hiavd_instance_name }}"
hiavd_config_file: "{{ hiavd_conf_dir }}/{{ hiavd_instance_name }}.conf"
hiavd_state_file: "{{ hiavd_conf_dir }}/serialized.dat"
hiavd_identifiers_file: "{{ hiavd_conf_dir }}/identifiers.dat"

is_not_witness: "{{ 'cluster_witness' not in group_names }}"
is_witness: "{{ 'cluster_witness' in group_names }}"
is_not_virtual: "{{ ansible_virtualization_role != 'guest' }}"
